{
  "build": {
    "buildCommand": "cd telegram-mini-app && npm install && npm run build"
  },
  "start": {
    "cmd": "uvicorn app.main:app --host 0.0.0.0 --port $PORT"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicy": "always",
    "resources": {
      "cpu": 2,
      "memory": 2048
    }
  },
  "healthCheck": {
    "httpPath": "/health",
    "timeoutSeconds": 10,
    "intervalSeconds": 30,
    "successThreshold": 1,
    "failureThreshold": 3
  }
}
