{
  "build": {
    "builder": "dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicy": "always",
    "resources": {
      "cpu": 2,
      "memory": 2048
    }
  },
  "healthCheck": {
    "httpPath": "/health",
    "timeoutSeconds": 10,
    "intervalSeconds": 30,
    "successThreshold": 1,
    "failureThreshold": 3
  }
}
