# Railway Deployment Environment Variables
# SSH Tunnel Configuration for NAS PostgreSQL Access
# SMB Mount Configuration for NAS Data Persistence

# ============================================================================
# SSH TUNNEL - NAS PostgreSQL Access
# ============================================================================
# Railway backend connects via SSH tunnel to NAS PostgreSQL
# This allows secure access to NAS databases from Railway environment

SSH_TUNNEL_ENABLED=true
NAS_HOST=192.168.1.117
NAS_USERNAME=kanat
NAS_PASSWORD=Drakuul55+

# ============================================================================
# SMB MOUNT - DISABLED FOR RAILWAY
# ============================================================================
# Railway cannot mount SMB shares from internal networks
# Disable SMB mounting for Railway deployments
# Data persists in Railway's ephemeral storage (acceptable for testing)

SMB_MOUNT_ENABLED=false
SMB_HOST=192.168.1.117
SMB_SHARE=temps
SMB_USERNAME=kanat
SMB_PASSWORD=Drakuul55+
MOUNT_POINT=/app/data

# Database Configuration - Via SSH Tunnel
# Note: When SSH tunnel is enabled, these host/port are for LOCAL fallback only
# The actual connection uses SSH tunnel to NAS on 127.0.0.1:5432
MAGLIB_HOST=127.0.0.1
MAGLIB_PORT=5432
MAGLIB_USER=docling
MAGLIB_PASSWORD=docling_secure_pwd_2024
MAGLIB_DATABASE=magick_knowledge

BIBLIOTHEK_HOST=127.0.0.1
BIBLIOTHEK_PORT=5432
BIBLIOTHEK_USER=docling
BIBLIOTHEK_PASSWORD=docling_secure_pwd_2024
BIBLIOTHEK_DATABASE=bibliothek_knowledge

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-...  # Set actual key in Railway Secrets
OPENAI_MODEL=gpt-4-mini

# Telegram Configuration
TELEGRAM_BOT_TOKEN=7890013797:AAEICc2_4XY89WbTrMa0Zt5IPkvwt_Wkn7g
TELEGRAM_BOT_USERNAME=AkashaAIHub_bot

# Application Settings
PRIVATE_MODE=false
AUTH_REQUIRED=true
MODE=saas

# Port (hardcoded in Dockerfile CMD, do not use environment variable)
# PORT=8200

# Railway-specific
ENVIRONMENT=production

# DODO Payments Configuration
DODO_API_KEY=N6fEBV3BuD6qgWtC.TkHLJkc4p0Hma1MIT9nC7kGHyMu9A7agnz0ymBrS08Gzr7Su
DODO_WEBHOOK_SECRET=whsec_74DMUulbzBtYl5/+2Gze1eLW0sSm8sUk
